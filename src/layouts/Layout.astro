---
import "@/styles/global.css";
import { siteConfig } from "@/lib/config";
import SkipToContent from "@/components/SkipToContent.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url)
  .href;
const ogImage = new URL(siteConfig.ogImage, Astro.site ?? siteConfig.url).href;
---

<!doctype html>
<html lang={siteConfig.lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- Default: white mark on black circle (older browsers / no media support) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Adaptive: follows OS / browser chrome (Safari, Chrome, Firefox) -->
    <link
      rel="icon"
      href="/favicon-light.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/favicon-dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0a0a0a"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Peracto — Agentic engineering. Executive judgment."
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Peracto — Agentic engineering. Executive judgment."
    />

    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts -->
    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body
    class="min-h-screen bg-background font-sans text-foreground antialiased"
  >
    <SkipToContent />
    <div
      class="mx-auto flex min-h-screen w-[calc(100%-1.5rem)] max-w-[1440px] flex-col border-x border-border sm:w-[calc(100%-2.5rem)] lg:w-[calc(100%-3rem)]"
    >
      <slot />
    </div>
  </body>
</html>
