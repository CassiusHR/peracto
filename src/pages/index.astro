---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.astro";
import SectionCorners from "@/components/SectionCorners.astro";
import LogoMarquee from "@/components/LogoMarquee.astro";
import FinalCTA from "@/components/FinalCTA.astro";
import Footer from "@/components/Footer.astro";

import { Header } from "@/components/header";
import { LogoDither } from "@/components/logo-dither";
import { Testimonials } from "@/components/testimonials";
import { Showcase } from "@/components/showcase";
import { Community } from "@/components/community";
import { Pricing } from "@/components/pricing";
import { Faq } from "@/components/faq";

const heroStats = [
  { label: "Engineering", value: "Agentic" },
  { label: "Delivery", value: "Embedded" },
  { label: "Leadership", value: "Fractional" },
];

const scaffoldCards = [
  {
    title: "Build with AI",
    body: "Turn a product idea or operational bottleneck into software and agents your team can use.",
  },
  {
    title: "Work inside the problem",
    body: "Bring engineers into your context to connect systems, deliver improvements, and transfer knowledge.",
  },
  {
    title: "Lead with clarity",
    body: "Give technology and product decisions a clear owner, a practical roadmap, and executive perspective.",
  },
];

const steps = [
  {
    title: "Define the outcome",
    body: "Understand the problem, establish a baseline, and agree on scope, access, and ownership.",
  },
  {
    title: "Build in context",
    body: "Work with your team and systems. Use small releases to test assumptions and get feedback early.",
  },
  {
    title: "Validate in operation",
    body: "Check quality, adoption, and results against the starting point. Review agent behavior with real constraints.",
  },
  {
    title: "Transfer and evolve",
    body: "Document the solution, transfer knowledge, and agree on what your team owns and where we stay involved.",
  },
];
---

<Layout title="Agentic development & Fractional CTO/CPO">
  <Header client:load />
  <main id="main-content" class="flex-1">
    <section class="relative border-b border-border">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div
          class="flex min-h-130 flex-col justify-center px-6 py-16 sm:px-10 sm:py-20 lg:min-h-160 lg:border-r lg:border-border lg:px-14 lg:py-24"
        >
          <h1
            style="--enter-delay: 380ms"
            class="enter text-4xl font-medium leading-[1.05] tracking-tighter text-foreground sm:text-5xl lg:text-[4rem] xl:text-[5.5rem]"
          >
            Agentic engineering. Executive judgment.
          </h1>
          <div
            style="--enter-delay: 520ms"
            class="enter mt-10 flex flex-wrap items-center gap-6"
          >
            <a
              href="mailto:contacto@perac.to"
              class="focus-ring inline-flex items-center gap-2 rounded-full bg-foreground px-5 py-4 text-xs font-semibold uppercase tracking-[0.12em] text-background transition-opacity hover:opacity-90"
            >
              Discuss your project
            </a>
            <a
              href="#services"
              class="focus-ring inline-flex items-center gap-2 rounded-full px-2 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-foreground transition-colors hover:text-muted-foreground"
            >
              Explore services
              <span
                class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-foreground"
                aria-hidden="true"
              >
                <span
                  class="ml-px block h-0 w-0 border-y-4 border-l-[6px] border-y-transparent border-l-background"
                ></span>
              </span>
            </a>
          </div>
        </div>

        <div
          style="--enter-delay: 200ms"
          class="enter-fade relative min-h-80 overflow-hidden lg:min-h-160"
        >
          <LogoDither
            client:load
            spinSpeed={0.2}
            axisTilt={84}
            axisDir={242}
            depthScale={0.4}
            ambient={0.5}
            light={0.8}
            brightness={0.5}
          />
        </div>
      </div>

      <div class="grid grid-cols-1 border-t border-border lg:grid-cols-2">
        <div
          class="border-b border-border px-6 py-10 sm:px-10 lg:border-b-0 lg:border-r lg:px-14"
        >
          <p
            style="--enter-delay: 680ms"
            class="enter max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg"
          >
            We build software and AI agents, embed with your team, and provide
            the technology and product leadership to bring your plans into
            operation.
          </p>
        </div>
        <div class="grid grid-cols-3 px-6 py-10 sm:px-10 lg:px-14">
          {
            heroStats.map((stat, i) => (
              <div class="enter" style={`--enter-delay: ${740 + i * 80}ms`}>
                <p class="text-xs font-medium tracking-wide text-muted-foreground sm:text-sm">
                  {stat.label}
                </p>
                <p class="mt-3 text-lg font-semibold tracking-tight text-foreground sm:text-2xl">
                  {stat.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
      <SectionCorners />
    </section>

    <Reveal>
      <section class="relative border-b border-border p-6 sm:p-10 lg:p-14">
        <h2
          class="text-balance text-2xl font-semibold leading-[1.1] tracking-tight text-foreground sm:text-3xl lg:text-[2.5rem]"
        >
          From business priorities to working systems
        </h2>

        <div
          class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3 lg:mt-16 lg:gap-6"
        >
          {
            scaffoldCards.map((card, i) => (
              <article
                class:list={[
                  "group relative flex min-h-65 flex-col justify-between rounded-2xl bg-muted p-6 sm:p-8 lg:min-h-75",
                  i > 0 &&
                    "md:before:absolute md:before:-left-2 md:before:top-0 md:before:bottom-0 md:before:w-px md:before:bg-border md:before:content-[''] lg:before:-left-3",
                ]}
              >
                <h3 class="text-balance text-lg font-semibold leading-tight tracking-tight text-foreground sm:text-xl">
                  {card.title}{" "}
                  <span
                    aria-hidden="true"
                    class="inline-block transition-transform duration-300 ease-out group-hover:translate-x-1"
                  >
                    →
                  </span>
                </h3>
                <p class="mt-12 max-w-[28ch] text-sm leading-relaxed text-muted-foreground sm:text-base">
                  {card.body}
                </p>
              </article>
            ))
          }
        </div>
        <SectionCorners />
      </section>
    </Reveal>

    <Reveal>
      <section class="relative border-b border-border p-6 sm:p-10 lg:p-14">
        <div class="relative grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-6">
          <article
            class="flex min-h-90 flex-col justify-between rounded-2xl border border-border bg-background p-6 sm:p-8 lg:min-h-120"
          >
            <h2
              class="max-w-md text-2xl font-semibold leading-[1.15] tracking-tight text-foreground sm:text-3xl lg:text-[2rem]"
            >
              <span class="text-muted-foreground">Inside your team.</span>
              Accountable to the outcome.
            </h2>
            <p
              class="mt-12 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base"
            >
              Good engineering starts with context. We work with the people,
              systems, and constraints behind the problem, from the first
              product decision through delivery and adoption.
            </p>
          </article>
          <div
            class="relative min-h-90 overflow-hidden rounded-2xl bg-muted lg:min-h-120"
          >
            <LogoMarquee />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute top-0 bottom-0 hidden w-px -translate-x-1/2 bg-border lg:block"
            style="left: 50%"
          >
          </div>
        </div>
        <SectionCorners />
      </section>
    </Reveal>

    <Reveal>
      <section
        id="approach"
        class="relative scroll-mt-24 border-b border-border"
      >
        <div class="px-6 pt-6 sm:px-10 sm:pt-10 lg:px-14 lg:pt-14">
          <h2
            class="text-2xl font-semibold leading-[1.1] tracking-tight text-foreground sm:text-3xl lg:text-[2.5rem]"
          >
            From the problem to production
          </h2>
        </div>

        <div class="mt-12 border-t border-border lg:mt-16">
          {
            steps.map((step, i) => (
              <div class="grid grid-cols-[auto_1fr] items-center gap-x-6 gap-y-3 border-b border-border px-6 py-6 sm:grid-cols-[auto_minmax(0,18rem)_minmax(0,1fr)] sm:gap-x-10 sm:px-10 sm:py-8 lg:px-14">
                <div class="row-span-2 flex h-10 w-10 items-center justify-center self-center rounded-md border border-border font-mono text-sm text-foreground sm:row-span-1">
                  {i + 1}
                </div>
                <h3 class="text-lg font-semibold leading-tight tracking-tight text-foreground sm:text-xl">
                  {step.title}
                </h3>
                <p class="col-start-2 max-w-prose text-sm leading-relaxed text-muted-foreground sm:col-start-3 sm:text-base">
                  {step.body}
                </p>
              </div>
            ))
          }
        </div>

        <div
          class="px-6 pb-6 pt-10 sm:px-10 sm:pb-10 sm:pt-12 lg:px-14 lg:pb-14"
        >
          <a
            href="#engagements"
            class="focus-ring inline-flex items-center gap-2 rounded-full bg-foreground px-5 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.12em] text-background transition-opacity hover:opacity-90"
          >
            Find your engagement
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <SectionCorners />
      </section>
    </Reveal>

    <Reveal>
      <Testimonials client:visible />
    </Reveal>
    <Reveal>
      <Showcase client:visible />
    </Reveal>
    <Community client:visible />
    <Reveal>
      <Pricing client:visible />
    </Reveal>
    <Reveal>
      <Faq client:visible />
    </Reveal>
  </main>
  <Reveal>
    <FinalCTA />
  </Reveal>
  <Footer />
</Layout>
