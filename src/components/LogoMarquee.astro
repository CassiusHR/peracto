---
// Monochrome brand paths: Simple Icons 11.15.0 (CC0).
// Source: https://github.com/simple-icons/simple-icons/tree/11.15.0/icons
import nextjs from "@/assets/logos/nextdotjs.svg?raw";
import astro from "@/assets/logos/astro.svg?raw";
import vercel from "@/assets/logos/vercel.svg?raw";
import cloudflare from "@/assets/logos/cloudflare.svg?raw";
import aws from "@/assets/logos/amazonaws.svg?raw";
import railway from "@/assets/logos/railway.svg?raw";
import swift from "@/assets/logos/swift.svg?raw";
import posthog from "@/assets/logos/posthog.svg?raw";
import sentry from "@/assets/logos/sentry.svg?raw";

const glyphs = [
  { name: "Next.js", svg: nextjs },
  { name: "Astro", svg: astro },
  { name: "Vercel", svg: vercel },
  { name: "Cloudflare", svg: cloudflare },
  { name: "AWS", svg: aws },
  { name: "Railway", svg: railway },
  { name: "Swift", svg: swift },
  { name: "PostHog", svg: posthog },
  { name: "Sentry", svg: sentry },
];

const colA = glyphs.filter((_, i) => i % 2 === 0);
const colB = glyphs.filter((_, i) => i % 2 === 1);

const columns = [
  { glyphSet: colA, animation: "marquee-up", duration: "22s" },
  { glyphSet: colB, animation: "marquee-down", duration: "26s" },
];
---

<div
  class="logo-marquee relative h-full min-h-[360px] w-full overflow-hidden"
  style="mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent); -webkit-mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);"
>
  <div
    class="logo-columns absolute inset-0 mx-auto grid max-w-[220px] grid-cols-2 place-items-center gap-1 sm:max-w-[260px]"
  >
    {
      columns.map((col) => (
        <div
          class="logo-column flex flex-col items-center"
          style={`animation: ${col.animation} ${col.duration} linear infinite`}
        >
          {["a", "b"].map((copy) => (
            <div
              class="logo-copy flex shrink-0 flex-col items-center gap-4 pb-4"
              aria-hidden={copy === "b" ? "true" : undefined}
            >
              {col.glyphSet.map((g) => (
                <div
                  title={g.name}
                  class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-background text-foreground sm:h-24 sm:w-24"
                >
                  <div class="h-9 w-9 sm:h-10 sm:w-10" set:html={g.svg} />
                </div>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  :global(html:not(.animations-enabled)) .logo-marquee {
    mask-image: none !important;
    -webkit-mask-image: none !important;
  }
  :global(html:not(.animations-enabled)) .logo-columns {
    max-width: 320px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  :global(html:not(.animations-enabled)) .logo-column {
    display: contents;
    animation: none !important;
  }
  :global(html:not(.animations-enabled)) .logo-copy {
    display: contents;
  }
  :global(html:not(.animations-enabled)) .logo-copy[aria-hidden="true"] {
    display: none;
  }
  :global(.motion-paused) .logo-column {
    animation-play-state: paused !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }
    .logo-columns {
      max-width: 320px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .logo-column {
      display: contents;
      animation: none !important;
    }
    .logo-copy {
      display: contents;
    }
    .logo-copy[aria-hidden="true"] {
      display: none;
    }
  }
</style>
