---
import { DitherShader } from "@/components/dither-shader";
---

<section id="contact" class="scroll-mt-24 bg-background p-6 sm:p-10 lg:p-14">
  <div
    class="overflow-hidden rounded-3xl border border-border bg-neutral-50 text-neutral-950 dark:bg-neutral-950 dark:text-neutral-50"
  >
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_minmax(0,420px)]">
      <div
        class="flex min-h-80 flex-col justify-center px-8 py-12 sm:px-12 sm:py-16 lg:border-r lg:border-neutral-200 lg:px-14 lg:py-20 dark:lg:border-neutral-800"
      >
        <h2
          class="max-w-md text-3xl font-medium leading-[1.1] tracking-tight sm:text-4xl lg:text-[2.5rem]"
        >
          What do you need to build or resolve?
        </h2>
        <p
          class="mt-6 max-w-md text-base leading-relaxed text-muted-foreground"
        >
          Tell us what is holding your business back and what needs to change.
        </p>
        <div class="mt-10">
          <a
            href="mailto:contacto@perac.to"
            class="focus-ring inline-flex items-center gap-2 rounded-full bg-neutral-950 px-5 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.12em] text-neutral-50 transition-opacity hover:opacity-90 dark:bg-neutral-50 dark:text-neutral-950"
          >
            Discuss your project
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <a
          href="mailto:contacto@perac.to"
          class="focus-ring mt-5 w-fit rounded-sm text-sm text-muted-foreground underline underline-offset-4"
          >contacto@perac.to</a
        >
      </div>

      <div class="relative min-h-80 p-2 lg:min-h-90">
        <div
          class="relative h-full w-full overflow-hidden rounded-2xl border border-neutral-200 dark:border-neutral-800"
        >
          <DitherShader variant="cta" client:visible />
        </div>
      </div>
    </div>
  </div>
</section>
