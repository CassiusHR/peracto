<button
  type="button"
  data-motion-toggle
  hidden
  aria-pressed="false"
  class="focus-ring absolute right-4 bottom-4 z-10 min-h-10 rounded-full bg-muted px-4 text-xs font-medium text-foreground transition-colors hover:bg-border"
  >Pause animations</button
>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-motion-toggle]"
  );
  const media = window.matchMedia("(prefers-reduced-motion: reduce)");
  const update = () => {
    if (!button) return;
    const paused = document.documentElement.classList.contains("motion-paused");
    document.documentElement.classList.add("animations-enabled");
    button.hidden = media.matches;
    button.setAttribute("aria-pressed", String(paused));
    button.textContent = paused ? "Resume animations" : "Pause animations";
  };
  button?.addEventListener("click", () => {
    document.documentElement.classList.toggle("motion-paused");
    document.dispatchEvent(new Event("motionchange"));
    update();
  });
  media.addEventListener("change", update);
  update();
</script>
