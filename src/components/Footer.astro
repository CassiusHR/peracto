---
const linkColumns = [
  {
    label: "Peracto",
    items: [
      { label: "Home", href: "#main-content" },
      { label: "Approach", href: "#approach" },
      { label: "Engagements", href: "#engagements" },
    ],
  },
  {
    label: "Services",
    items: [
      { label: "Agentic Development", href: "#services" },
      { label: "Forward Deployed Engineering", href: "#services" },
      { label: "Fractional CTO / CPO", href: "#services" },
      { label: "Executive Advisory", href: "#services" },
    ],
  },
  {
    label: "Connect",
    items: [
      { label: "FAQs", href: "#faq" },
      { label: "Contact", href: "#contact" },
      { label: "contacto@perac.to", href: "mailto:contacto@perac.to" },
    ],
  },
];

const year = new Date().getFullYear();
---

<section class="bg-background p-3 sm:p-4 lg:p-6">
  <div
    class="rounded-3xl bg-neutral-950! px-5 py-8 text-neutral-100! sm:px-8 sm:py-10 lg:px-10 lg:py-12 dark:bg-neutral-50! dark:text-neutral-900!"
  >
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[auto_1fr_auto] lg:gap-16">
      <div>
        <a
          href="#main-content"
          class="focus-ring inline-flex items-center gap-2 rounded-sm text-sm text-neutral-100 transition-colors hover:text-white dark:text-neutral-900 dark:hover:text-black"
        >
          Back to top
          <span aria-hidden="true">↑</span>
        </a>
      </div>

      <nav
        aria-label="Footer"
        class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:gap-x-12"
      >
        {
          linkColumns.map((column) => (
            <div>
              {column.label ? (
                <p class="mb-5 text-sm text-neutral-500 dark:text-neutral-500">
                  {column.label}
                </p>
              ) : (
                <p
                  class="mb-5 text-sm text-neutral-500 dark:text-neutral-500"
                  aria-hidden="true"
                >
                  &nbsp;
                </p>
              )}
              <ul class="space-y-3">
                {column.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="focus-ring rounded-sm text-sm text-neutral-100 transition-colors hover:text-white dark:text-neutral-900 dark:hover:text-black"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="lg:pt-px">
        <a
          href="mailto:contacto@perac.to"
          class="focus-ring inline-flex items-center gap-2 rounded-full border border-neutral-700 px-5 py-3 text-xs font-semibold uppercase tracking-[0.12em] text-neutral-100 transition-colors hover:border-neutral-500 dark:border-neutral-300 dark:text-neutral-900 dark:hover:border-neutral-500"
        >
          Talk to the team
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-6 pt-8 sm:flex-row sm:items-center lg:mt-24"
    >
      <div class="flex items-center gap-2.5">
        <img
          src="/peracto-icon.svg"
          alt=""
          width="20"
          height="20"
          class="h-5 w-5 shrink-0 invert dark:invert-0"
          aria-hidden="true"
        />
        <img
          src="/peractoname1.svg"
          alt="Peracto"
          width="83"
          height="20"
          class="h-5 w-auto shrink-0 invert dark:invert-0"
        />
      </div>

      <p class="text-sm text-neutral-500 dark:text-neutral-500">
        © {year} Peracto. All rights reserved.
      </p>
    </div>
  </div>
</section>
